doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Password Reset - DarkNDusky
    style.
      body, table, td, a {
        font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      }
      @media screen and (max-width: 600px) {
        .container {
          width: 100% !important;
          padding: 20px !important;
        }
        .cta-button {
          display: block !important;
          width: 100% !important;
          text-align: center !important;
        }
      }
  body(style="margin:0; padding:0; background-color:#f7f5f3; font-family: Arial, sans-serif;")
    table(width="100%", cellpadding="0", cellspacing="0", border="0", bgcolor="#f7f5f3")
      tr
        td(align="center")
          table.container(width="600", cellpadding="0", cellspacing="0", border="0", style="max-width:600px; background-color:#ffffff; border-radius:8px; overflow:hidden; margin:40px auto; box-shadow:0 0 8px rgba(0,0,0,0.05);")

            //- Logo Section
            tr
              td(align="center", style="background-color:#1e1e1e; padding:30px;")
                img(src="https://images.seeklogo.com/logo-png/51/2/dungeons-dragons-5th-edition-logo-png_seeklogo-517840.png", alt="Dark&Dusky Logo", width="150", style="display:block; width:150px; height:auto;")

            //- Password Reset Content
            tr
              td(style="padding:30px; color:#333333; font-size:16px; line-height:1.6;")
                h1(style="margin:0 0 15px 0; font-size:24px; color:#2c2c2c;") Reset Your Password
                p(style="margin:0 0 15px 0;") Hi #{name},
                p(style="margin:0 0 15px 0;")
                  | We received a request to reset your password for your 
                  strong
                    em Dark&Dusky
                  |  account.
                p(style="margin:0 0 20px 0;") Click the button below to set a new password.

                //- CTA Button
                table(align="center", cellpadding="0", cellspacing="0", border="0", style="margin:0 auto;")
                  tr
                    td(align="center", bgcolor="#e28402", style="border-radius:5px;")
                      a.cta-button(href="#{resetUrl}", style="display:inline-block; padding:14px 24px; font-size:16px; color:#ffffff; text-decoration:none; font-weight:bold;") Reset Password

                //- Fallback URL
                p(style="margin:30px 0 10px 0; font-size:14px; color:#666666;")
                  | If the button above doesn't work, just copy and paste the following URL into your browser:
                p(style="word-break:break-all; font-size:14px; color:#0066cc;")
                  a(href="#{resetUrl}", style="color:#0066cc; text-decoration:underline;") #{resetUrl}

                p(style="margin-top:30px; font-size:13px; color:#999999;")
                  | If you didn’t request a password reset, you can safely ignore this email.

            //- Footer
            tr
              td(style="background-color:#f0ece9; text-align:center; padding:20px; font-size:13px; color:#888888;")
                | © 2025 Dark&Dusky. All rights reserved.
                br
                | Kanpur, India